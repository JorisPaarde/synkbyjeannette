---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion, { type FAQItem } from './FAQAccordion';

interface Props {
  lang?: 'nl' | 'en';
}

const { lang = 'nl' } = Astro.props;
const isEnglish = lang === 'en';
const currentPath = isEnglish ? '/en/veelgestelde-vragen/' : '/veelgestelde-vragen/';

const nlItems: FAQItem[] = [
  {
    question: 'Wat is het verschil tussen een VA en een remote Project Manager-Producer?',
    answer: '<p>Een VA voert taken uit op afstand.</p><p>Een remote Project Manager-Producer, zoals SYNK, denkt mee op strategisch niveau, stelt prioriteiten, bewaakt voortgang en werkt alsof het haar eigen project is.</p><p>Je krijgt dus geen assistent — je krijgt iemand die ownership neemt.</p>',
  },
  {
    question: 'Wat zijn de voordelen van werken met een Remote Project Manager-Producer?',
    answer: '<ul><li>Flexibiliteit: inzetbaar op afstand én op locatie</li><li>Efficiëntie: minder overhead dan een traditionele projectmanager</li><li>Schaalbaarheid: werkt met jouw systemen en tools</li><li>Productiviteit: meer rust, minder ruis, betere resultaten</li><li>Uitgebreid netwerk in verschillende creatieve disciplines</li></ul>',
  },
  {
    question: 'Voor wie is SYNK?',
    answer: '<p>Voor ondernemers die veel aan hun hoofd hebben en behoefte hebben aan structuur, overzicht en een strategische sparringpartner.</p><p>Het kan ook een ondernemersechtpaar uit London zijn.</p><p>Ideaal als je nog geen team wilt aannemen, maar wél regie nodig hebt — of de overhead van personeel in vaste dienst wilt vermijden.</p>',
  },
  {
    question: 'Werk je alleen of met een team?',
    answer: '<p>Ik werk zelfstandig, maar heb een netwerk van bleeding-edge specialisten: strategen, copywriters, art directors, AI-experts (nationaal en internationaal), webdevelopers, fotografen, producers en eventmanagers.</p><p>Indien nodig stel ik snel een team samen dat past bij jouw project en stijl.</p>',
  },
  {
    question: 'Kan ik je inschakelen voor een eenmalig project?',
    answer: '<p>Zeker. Denk aan:</p><ul><li>Het coördineren van een marketingcampagne</li><li>Het reorganiseren van je backoffice</li><li>Het voorbereiden van een belangrijke lancering</li></ul><p>We bepalen samen het gewenste resultaat en de aanpak.</p><p>Heb je een deadline die gisteren al gehaald moest worden?</p><p>Geen stress. Ik ben hectiek gewend en brengt rust in chaos.</p><p>Of het nu gaat om een last-minute presentatie, eventcoördinatie of het redden van een project dat uit de bocht vliegt — ik schakel snel en met focus.</p>',
  },
  {
    question: 'Werk je internationaal of in meerdere tijdzones?',
    answer: '<p>Ja. Ik werk met internationale klanten, communiceer vloeiend in het Engels en stem moeiteloos af op verschillende ritmes en workflows — ook buiten kantooruren.</p>',
  },
];

const enItems: FAQItem[] = [
  {
    question: 'What’s the difference between a VA and a remote Project Manager-Producer?',
    answer: '<p>A VA executes tasks remotely.</p><p>A remote Project Manager-Producer, like SYNK, thinks along at a strategic level, sets priorities, monitors progress, and works as if it’s her own project.</p><p>So you don’t get an assistant — you get someone who takes ownership.</p>',
  },
  {
    question: 'What are the benefits of working with a Remote Project Manager-Producer?',
    answer: '<ul><li>Flexibility: Available remotely and on-site</li><li>Efficiency: Less overhead than a traditional project manager</li><li>Scalability: Works with your systems and tools</li><li>Productivity: More peace, less noise, better results</li><li>Extensive network in various creative disciplines</li></ul>',
  },
  {
    question: 'Who is SYNK for?',
    answer: '<p>For entrepreneurs with a lot on their plate who need structure, clarity, and a strategic sparring partner.</p><p>It could also be a founder couple from London.</p><p>Ideal if you’re not ready to hire a team but do need direction — or want to avoid the overhead of permanent staff.</p>',
  },
  {
    question: 'Do you work alone or with a team?',
    answer: '<p>I work independently but have a network of bleeding-edge specialists: strategists, copywriters, art directors, AI experts (national and international), web developers, photographers, producers, and event managers.</p><p>If needed, I quickly assemble a team that fits your project and style.</p>',
  },
  {
    question: 'Can I hire you for a one-off project?',
    answer: '<p>Absolutely. Think of:</p><ul><li>Coordinating a marketing campaign</li><li>Reorganizing your back office</li><li>Preparing for a major launch</li></ul><p>We’ll define the desired outcome and approach together.</p><p>Have a deadline that was due yesterday?</p><p>No stress. I’m used to chaos and bring calm to it.</p><p>Whether it’s a last-minute presentation, event coordination, or rescuing a project that’s gone off the rails — I act fast and with focus.</p>',
  },
  {
    question: 'Do you work internationally or across time zones?',
    answer: '<p>Yes. I work with international clients, communicate fluently in English, and easily adapt to different rhythms and workflows — even outside office hours.</p>',
  },
];

const pageTitle = isEnglish ? 'Frequently asked questions – SYNK by Jeanette' : 'Veelgestelde vragen – SYNK by Jeanette';
---

<BaseLayout title={pageTitle} lang={lang} currentPath={currentPath}>
  <section class="faq-page">
    <h1>{isEnglish ? 'Frequently asked questions' : 'Veelgestelde vragen'}</h1>
    <FAQAccordion items={isEnglish ? enItems : nlItems} client:load />
  </section>
</BaseLayout>
