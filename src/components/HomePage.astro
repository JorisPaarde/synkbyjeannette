---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from './LogoMarquee.astro';
import ProblemQuote from './ProblemQuote.astro';
import ScrollArt from './ScrollArt.astro';
import { withBase } from '../lib/paths';

interface Props {
  lang?: 'nl' | 'en';
}

const { lang = 'nl' } = Astro.props;
const isEnglish = lang === 'en';
const currentPath = isEnglish ? '/en/' : '/';

const serviceLine = isEnglish
  ? 'EMAIL MANAGEMENT – CALENDAR AND TRAVEL PLANNING – EVENTS – CONCEPT DEVELOPMENT – PROJECT COORDINATION – BACK OFFICE –'
  : 'E-MAILBEHEER - AGENDA EN REISPLANNING - EVENTS - CONCEPTONTWIKKELING - PROJECTREGIE - BACKOFFICE -';

const profileWords = isEnglish
  ? ['Direction', 'Without', 'Noise', 'Overview', 'Without', 'Overhead']
  : ['Regie', 'Zonder', 'Ruis', 'Overzicht', 'Zonder', 'Overhead'];
const profileMaskId = `profile-mask-${lang}`;
---

<BaseLayout
  title="Synk – Your PA and Project Manager Producer"
  description="Your PA and Project Manager Producer. Rust, overzicht en strategische precisie."
  lang={lang}
  currentPath={currentPath}
>
  <section class="hero">
    <div class="hero__content">
      <img class="hero__logo" src={withBase('/assets/images/synk-logo.png')} alt="SYNK" fetchpriority="high" data-reveal="slideInDown" />
      <h1 class="hero__byline" data-reveal="slideInRight">by Jeanette</h1>
      <p class="hero__statement">
        {isEnglish ? (
          <>At a high level, it ultimately comes down to<br />one thing: <em>peace of mind.</em> because peace of mind creates space<br />to stay sharp and focus<br />running your business.</>
        ) : (
          <>Op hoog niveau draait het uiteindelijk<br />om één ding: <em>rust.</em> Want rust creëert de ruimte<br />om scherp te blijven en te focussen op<br />je expertise.</>
        )}
      </p>
      <p class="hero__role">Your PA and<br />Project Manager Producer</p>
    </div>
  </section>

  <section class="hero-mobile-statement editorial-panel editorial-panel--white">
    <p class="hero-mobile-statement__copy">
      {isEnglish ? (
        <>
          <span>At a high level, it ultimately comes down to</span>
          <span>one thing: <em>peace of mind.</em> Because peace of mind creates</span>
          <span>the space to stay sharp and focus on</span>
          <span>running your business.</span>
        </>
      ) : (
        <>
          <span>Op hoog niveau draait het uiteindelijk</span>
          <span>om één ding: <em>rust.</em> Want rust creëert</span>
          <span>de ruimte om scherp te blijven</span>
          <span>en te focussen op je expertise.</span>
        </>
      )}
    </p>
  </section>

  <section class="split-section bordered-section intro-section">
    <div class="intro-copy editorial-panel editorial-panel--white">
      <div class="editorial-copy">
        <p>Als remote PA, Project Manager en Producer ben ik meer dan een assistent op afstand.</p>
        <p>Ik ontzorg, denk mee en kijk vooruit.</p>
        <p>Complexe projecten pak ik vast als een pitbull. No worries, ik bijt niet.</p>
      </div>
    </div>
    <div class="intro-quote editorial-panel editorial-panel--grey editorial-panel--quote">
      <blockquote class="editorial-quote editorial-quote--statement">
        {isEnglish ? (
          <>
            <span>FOR A “WOULD YOU” QUESTION</span>
            <span>I’LL CALL MY SECRETARY.</span>
            <span>FOR A <strong>“CAN YOU”</strong> QUESTION</span>
            <span>I CALL JEANETTE.</span>
          </>
        ) : (
          <>
            <span>VOOR EEN ‘WIL JIJ’ VRAAG</span>
            <span>BEL IK M’N SECRETARESSE.</span>
            <span>VOOR EEN <strong>‘KAN JIJ’</strong> VRAAG</span>
            <span>BEL IK JEANETTE.</span>
          </>
        )}
        <cite>Abdu Samad<br />Marketing Director Creative Events</cite>
      </blockquote>
    </div>
  </section>

  <LogoMarquee />

  <section class="split-section bordered-section profile-section">
    <div class="profile-art" aria-label="Portret van Jeanette met de woorden regie zonder ruis en overzicht zonder overhead" data-reveal="slideInUp">
      <img src={withBase('/assets/images/jeanette-portrait.png')} alt="Jeanette la Rivière" loading="lazy" />
      <div class="profile-art__words" aria-hidden="true">
        <svg class="profile-art__mask" viewBox="0 0 430 300" preserveAspectRatio="none" focusable="false">
          <defs>
            <mask id={profileMaskId} maskUnits="userSpaceOnUse">
              <rect width="430" height="300" fill="white" />
              {profileWords.map((word, index) => (
                <text x="18" y={35 + index * 45} dominant-baseline="middle" text-anchor="start">{word}</text>
              ))}
            </mask>
          </defs>
          <rect width="430" height="300" fill="currentColor" mask={`url(#${profileMaskId})`} />
        </svg>
      </div>
    </div>
    <div class="profile-copy editorial-panel editorial-panel--white" data-reveal="slideInUp">
      <div class="editorial-copy">
        {isEnglish ? (
          <>
            <p>I’m Jeanette la Rivière.</p>
            <p>Al meer dan 25 jaar breng ik rust voor bedrijven, organisaties &amp; ondernemers.</p>
            <p>Strategic &amp; Structured. Want om het onmogelijk mogelijk te maken heb je overzicht nodig.</p>
          </>
        ) : (
          <>
            <p>Ik ben Jeanette la Rivière.</p>
            <p>Al meer dan 25 jaar breng ik rust voor bedrijven, organisaties &amp; ondernemers.</p>
            <p>Strategisch &amp; gestructureerd. Want om het onmogelijk mogelijk te maken heb je overzicht nodig.</p>
          </>
        )}
      </div>
    </div>
  </section>

  <section class="split-section bordered-section experience-section">
    <div class="experience-copy editorial-panel editorial-panel--white" data-reveal="slideInUp">
      <div class="editorial-copy editorial-copy--wide">
        <p>Over 25 jaar is alles wel zo’n beetje voorbijgekomen.</p>
        <p>Van 24 uur live radiocommercials opnemen op straat in Londen tot het produceren van een Achmea-campagne met 24 echte dolfijnen.</p>
        <p>Of het produceren van beursstands voor vijf landen in Europa.</p>
      </div>
    </div>
    <div class="experience-photo" role="img" aria-label="Achmea-campagne met dolfijnen" data-reveal="slideInUp"></div>
  </section>

  <ScrollArt lang={lang} />

  <div data-reveal="slideInUp">
    <div class="service-ticker" aria-label={serviceLine}>
      <div class="service-ticker__track">
        <span class="service-ticker__group">{serviceLine}</span>
        <span class="service-ticker__group" aria-hidden="true">{serviceLine}</span>
      </div>
    </div>
  </div>

  <section class="split-section bordered-section manifesto-section">
    <div class="manifesto editorial-panel editorial-panel--white" data-reveal="slideInUp">
      <div class="editorial-copy editorial-copy--wide">
        <p>Ik breng rust, overzicht en strategische precisie in je bedrijf of organisatie.</p>
        <p>Want slimmer denken is geen slogan – het is een manier van werken die je tijd, energie en mentale ruimte teruggeeft.</p>
        <p>Think smart. Move with clarity. Live more.</p>
        <p>{isEnglish ? 'That is Synk by Jeanette.' : 'Dat is Synk by Jeanette.'}</p>
      </div>
    </div>
    <div class="artist-quote editorial-panel editorial-panel--grey editorial-panel--quote" data-reveal="slideInUp">
      <blockquote class="editorial-quote editorial-quote--dromers">
        {isEnglish ? (
          <>
            <span>Artists are</span>
            <span>dreamers.</span>
            <span class="editorial-quote--dromers__tail">
              <cite>JW Kaldenbach<br />Photographer</cite>
              <span class="editorial-quote--dromers__lines">
                <span>Doers like Jeanette</span>
                <span>make them possible.</span>
              </span>
            </span>
          </>
        ) : (
          <>
            <span>Kunstenaars zijn</span>
            <span>dromers.</span>
            <span class="editorial-quote--dromers__tail">
              <cite>JW Kaldenbach<br />Photographer</cite>
              <span class="editorial-quote--dromers__lines">
                <span>Doeners als Jeanette</span>
                <span>maken ze mogelijk.</span>
              </span>
            </span>
          </>
        )}
      </blockquote>
    </div>
  </section>

  <ProblemQuote />
</BaseLayout>
