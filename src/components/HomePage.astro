---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from './LogoMarquee.astro';
import ProblemQuote from './ProblemQuote.astro';
import ScrollArt from './ScrollArt.astro';
import { withBase } from '../lib/paths';

interface Props {
  lang?: 'nl' | 'en';
}

const { lang = 'nl' } = Astro.props;
const isEnglish = lang === 'en';
const currentPath = isEnglish ? '/en/' : '/';

const pageTitle = isEnglish
  ? 'SYNK by Jeanette – Direction, Results & Peace of Mind'
  : 'SYNK by Jeanette – regie, resultaat & rust';

const pageDescription = isEnglish
  ? 'As a remote project manager-producer, Jeanette brings entrepreneurs peace of mind — strategically and with structure.'
  : 'Als remote project manager-producer brengt Jeanette ondernemers rust — strategisch en gestructureerd.';

const serviceLine = isEnglish
  ? 'EMAIL MANAGEMENT – CALENDAR AND TRAVEL PLANNING – EVENTS – CONCEPT DEVELOPMENT – PROJECT COORDINATION – BACK OFFICE –'
  : 'E-MAILBEHEER - AGENDA EN REISPLANNING - EVENTS - CONCEPTONTWIKKELING - PROJECTREGIE - BACKOFFICE -';

const profileWords = isEnglish
  ? ['Direction', 'Without', 'Noise', 'Overview', 'Without', 'Overhead']
  : ['Regie', 'Zonder', 'Ruis', 'Overzicht', 'Zonder', 'Overhead'];
const profileMaskId = `profile-mask-${lang}`;

const profileArtLabel = isEnglish
  ? 'Portrait of Jeanette with the words Direction without Noise and Overview without Overhead'
  : 'Portret van Jeanette met de woorden Regie zonder Ruis en Overzicht zonder Overhead';

const tagline = isEnglish ? 'Direction, Results & Peace of Mind' : 'regie, resultaat & rust';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  currentPath={currentPath}
>
  <section class="hero">
    <div class="hero__content">
      <img class="hero__logo" src={withBase('/assets/images/synk-logo.png')} alt="SYNK" fetchpriority="high" data-reveal="slideInDown" />
      <h1 class="hero__byline" data-reveal="slideInRight">by Jeanette</h1>
      <p class="hero__statement">
        {isEnglish ? (
          <>
            As an entrepreneur, there’s really only one thing you want: <em>peace of mind.</em><br />
            Because peace of mind creates space to be creative and focus on what you’re truly good at: running your business.<br />
            As a remote project manager-producer, bringing you that peace is my focus.<br />
            That comforting “it’ll be fine” feeling — that’s what I do it for.
          </>
        ) : (
          <>
            Als ondernemer wil je eigenlijk maar één ding: <em>rust.</em><br />
            Want rust geeft ruimte om creatief te zijn en te focussen op waar je echt goed in bent: ondernemen.<br />
            Als remote project manager-producer is het brengen van jouw rust mijn focus.<br />
            Dat fijne ‘het-komt-goed-gevoel’, daar doe ik het voor.
          </>
        )}
      </p>
      <p class="hero__role">{tagline}</p>
    </div>
  </section>

  <section class="hero-mobile-statement editorial-panel editorial-panel--white">
    <p class="hero-mobile-statement__copy">
      {isEnglish ? (
        <>
          <span>As an entrepreneur, there’s really only one thing you want:</span>
          <span><em>peace of mind.</em> Because peace of mind creates space</span>
          <span>to be creative and focus on what you’re truly good at:</span>
          <span>running your business.</span>
          <span>As a remote project manager-producer, bringing you that peace is my focus.</span>
          <span>That comforting “it’ll be fine” feeling — that’s what I do it for.</span>
        </>
      ) : (
        <>
          <span>Als ondernemer wil je eigenlijk maar één ding:</span>
          <span><em>rust.</em> Want rust geeft ruimte om creatief te zijn</span>
          <span>en te focussen op waar je echt goed in bent: ondernemen.</span>
          <span>Als remote project manager-producer is het brengen van jouw rust mijn focus.</span>
          <span>Dat fijne ‘het-komt-goed-gevoel’, daar doe ik het voor.</span>
        </>
      )}
    </p>
  </section>

  <section class="split-section bordered-section intro-section">
    <div class="intro-copy editorial-panel editorial-panel--white">
      <div class="editorial-copy">
        {isEnglish ? (
          <>
            <p>“Jeanette, can you…”</p>
            <p>That’s how almost every question from a client begins. Because the “would you” is usually something they can solve internally.</p>
          </>
        ) : (
          <>
            <p>‘Jeanette, kan jij…’</p>
            <p>Zo begint bijna elke vraag die ik krijg van een opdrachtgever. Want de ‘wil jij’ is meestal intern wel op te lossen.</p>
          </>
        )}
      </div>
    </div>
    <div class="intro-quote editorial-panel editorial-panel--grey editorial-panel--quote">
      <blockquote class="editorial-quote editorial-quote--statement">
        {isEnglish ? (
          <>
            <span>FOR A “WOULD YOU” QUESTION</span>
            <span>I’LL CALL MY SECRETARY.</span>
            <span>FOR A <strong>“CAN YOU”</strong> QUESTION</span>
            <span>I CALL JEANETTE.</span>
          </>
        ) : (
          <>
            <span>VOOR EEN ‘WIL JIJ’ VRAAG</span>
            <span>BEL IK M’N SECRETARESSE.</span>
            <span>VOOR EEN <strong>‘KAN JIJ’</strong> VRAAG</span>
            <span>BEL IK JEANETTE.</span>
          </>
        )}
        <cite>Arco Bregman<br />CEO Youngworks</cite>
      </blockquote>
    </div>
  </section>

  <LogoMarquee lang={lang} />

  <section class="split-section bordered-section profile-section">
    <div class="profile-art" aria-label={profileArtLabel} data-reveal="slideInUp">
      <img src={withBase('/assets/images/jeanette-portrait.png')} alt="Jeanette la Riviere" loading="lazy" />
      <div class="profile-art__words" aria-hidden="true">
        <svg class="profile-art__mask" viewBox="0 0 430 300" preserveAspectRatio="none" focusable="false">
          <defs>
            <mask id={profileMaskId} maskUnits="userSpaceOnUse">
              <rect width="430" height="300" fill="white" />
              {profileWords.map((word, index) => (
                <text x="18" y={35 + index * 45} dominant-baseline="middle" text-anchor="start">{word}</text>
              ))}
            </mask>
          </defs>
          <rect width="430" height="300" fill="currentColor" mask={`url(#${profileMaskId})`} />
        </svg>
      </div>
    </div>
    <div class="profile-copy editorial-panel editorial-panel--white" data-reveal="slideInUp">
      <div class="editorial-copy">
        {isEnglish ? (
          <>
            <p>I’m Jeanette la Riviere. As a remote project manager-producer, I’ve been bringing peace of mind to entrepreneurs for over 25 years by taking work off their plate — strategically and with structure. Because to make the impossible possible, you need oversight.</p>
          </>
        ) : (
          <>
            <p>Ik ben Jeanette la Riviere. Als remote projectmanager- producer breng ik al meer dan 25 jaar rust voor ondernemers, door hen werk uit handen te nemen. Strategisch en gestructureerd. Want om het onmogelijke mogelijk te maken heb je overzicht nodig.</p>
          </>
        )}
      </div>
    </div>
  </section>

  <section class="split-section bordered-section testimonial-section">
    <div class="testimonial-quote editorial-panel editorial-panel--grey editorial-panel--quote" data-reveal="slideInUp">
      <blockquote class="editorial-quote editorial-quote--prose">
        <p>I very much enjoyed working with Jeanette. She's an experienced project manager/producer with a strong skill set who always strives to service people in the best possible way. She's very dedicated, eager to learn and has a great sense of humour. Jeanette is a people person who works well within a team and knows how to get the job done.</p>
        <cite>Claudia Casagrande<br />Nike Europe</cite>
      </blockquote>
    </div>
    <div class="testimonial-quote editorial-panel editorial-panel--grey editorial-panel--quote" data-reveal="slideInUp">
      <blockquote class="editorial-quote editorial-quote--prose">
        <p>Jeanette is passionate about her work, she thinks in solutions and once committed to a project she will do everything in her power to make stuff happen. And she is fun to work with.</p>
        <cite>Elwin Bes<br />Film Director</cite>
      </blockquote>
    </div>
  </section>

  <section class="split-section bordered-section experience-section">
    <div class="experience-copy editorial-panel editorial-panel--white" data-reveal="slideInUp">
      <div class="editorial-copy editorial-copy--wide">
        {isEnglish ? (
          <>
            <p>In 25 years, I’ve seen it all. From arranging a radio commercial for Eurostar in London to producing a Unox winter campaign — within 4 hours — with an actor in the sea wearing a Unox hat. Or a campaign with 24 dolphins for Achmea Health Care.</p>
            <p>But you can still wake me up for email or calendar management and booking travel. The fun is in the fixing.</p>
          </>
        ) : (
          <>
            <p>In 25 jaar tijd is alles wel zo’n beetje voorbij gekomen. Van het regelen van een radio commercial voor Eurostar in London tot het, binnen 4 uur, produceren van een Unox campagne in de winter met een acteur in de zee met een Unox muts op. Of een campagne met 24 dolfijnen voor Achmea health Care.</p>
            <p>Maar ook voor e-mail- of agenda-beheer en het boeken van reizen kan je me nog altijd wakker maken. De lol zit ‘m in het fixen.</p>
          </>
        )}
      </div>
    </div>
    <div class="experience-photo" role="img" aria-label={isEnglish ? 'Achmea campaign with dolphins' : 'Achmea-campagne met dolfijnen'} data-reveal="slideInUp"></div>
  </section>

  <ScrollArt lang={lang} />

  <div data-reveal="slideInUp">
    <div class="service-ticker" aria-label={serviceLine}>
      <div class="service-ticker__track">
        <span class="service-ticker__group">{serviceLine}</span>
        <span class="service-ticker__group" aria-hidden="true">{serviceLine}</span>
      </div>
    </div>
  </div>

  <section class="bordered-section sander-section">
    <div class="sander-quote editorial-panel editorial-panel--grey editorial-panel--quote" data-reveal="slideInUp">
      <blockquote class="editorial-quote editorial-quote--prose">
        {isEnglish ? (
          <p>Jeanette is a hard worker. In our intake, we immediately had a great conversation about what was going on in the agency and where the challenges lay. I’ve rarely seen someone map things out so quickly. What I love about Jeanette is that she’s pleasantly direct — if something’s off or could be better, she’ll tell you. And that works great!</p>
        ) : (
          <p>Jeanette is een harde werker. In de intake hadden we direct een goed gesprek over wat er binnen het bureau speelde en waar de uitdagingen lagen. Ik heb zelden meegemaakt dat iemand dat zo snel in kaart brengt. Het mooie aan Jeanette vind ik dat ze prettig direct is, zit haar iets dwars of kan iets beter. Dan krijg je dat terug en dat werkt fijn!</p>
        )}
        <cite>Sander Veenendaal<br />CEO</cite>
      </blockquote>
    </div>
  </section>

  <section class="split-section bordered-section manifesto-section">
    <div class="manifesto editorial-panel editorial-panel--white" data-reveal="slideInUp">
      <div class="editorial-copy editorial-copy--wide">
        {isEnglish ? (
          <>
            <p>I work independently but have a broad network of bleeding-edge AI specialists (national &amp; international), strategists, photographers, copywriters, art directors, web developers, producers, and event managers.</p>
            <p>If needed, I quickly assemble a scalable team that fits your project and style.</p>
            <p>With SYNK, you’re not buying hours — you’re investing in peace of mind and gaining time.</p>
          </>
        ) : (
          <>
            <p>Ik werk zelfstandig, maar heb een uitgebreid netwerk van AI bleeding edge specialisten (nationaal &amp; internationaal), strategen, fotografen, copywriters, art directors, webdevelopers, producers en eventmanagers.</p>
            <p>Indien nodig stel ik snel een schaalbaar team samen, dat past bij jouw project &amp; stijl.</p>
            <p>Met Synk huur je geen uren, je investeert in rust en wint tijd.</p>
          </>
        )}
      </div>
    </div>
    <div class="artist-quote editorial-panel editorial-panel--grey editorial-panel--quote" data-reveal="slideInUp">
      <blockquote class="editorial-quote editorial-quote--dromers">
        {isEnglish ? (
          <>
            <span>Artists are</span>
            <span>dreamers.</span>
            <span class="editorial-quote--dromers__tail">
              <cite>Jan Willem Kaldenbach<br />Photographer</cite>
              <span class="editorial-quote--dromers__lines">
                <span>Doers like Jeanette</span>
                <span>make them possible.</span>
              </span>
            </span>
          </>
        ) : (
          <>
            <span>Kunstenaars zijn</span>
            <span>dromers.</span>
            <span class="editorial-quote--dromers__tail">
              <cite>Jan Willem Kaldenbach<br />Fotograaf</cite>
              <span class="editorial-quote--dromers__lines">
                <span>Doeners als Jeanette</span>
                <span>maken ze mogelijk.</span>
              </span>
            </span>
          </>
        )}
      </blockquote>
    </div>
  </section>

  <ProblemQuote />
</BaseLayout>
