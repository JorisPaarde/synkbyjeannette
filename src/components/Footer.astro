---
interface Props {
  lang?: 'nl' | 'en';
}

const { lang = 'nl' } = Astro.props;
const isEnglish = lang === 'en';
---

<footer class="site-footer synk-footer-reveal">
  <section class="contact-strip synk-footer-reveal-item" aria-label="Contact">
    {isEnglish ? (
      <>
        <p>
          Curious how I can bring you peace of mind by efficiently producing your project(s)?
          Email me at <a href="mailto:jeanette@synkbyjeanette.com">jeanette@synkbyjeanette.com</a>
        </p>
        <p>
          or call / WhatsApp <a href="tel:+31646611718">+31 6 4661 1718</a> for a no-obligation coffee.
        </p>
      </>
    ) : (
      <>
        <p>
          Nieuwsgierig hoe ik jou rust kan geven door project(en) efficiënt te produceren?
          Mail me op <a href="mailto:jeanette@synkbyjeanette.com">jeanette@synkbyjeanette.com</a>
        </p>
        <p>
          of bel / app naar <a href="tel:+31646611718">+31 6 4661 1718</a> voor een vrijblijvende bak koffie.
        </p>
      </>
    )}
  </section>

  <section class="social-strip synk-footer-reveal-item">
    <a
      class="linkedin-mark"
      href="https://www.linkedin.com/in/jeanetteriviere/"
      aria-label="LinkedIn"
      rel="noreferrer"
    >in</a>
  </section>

  <section class="credits-strip synk-footer-reveal-item">
    <h2>{isEnglish ? 'With many thanks to:' : 'Met heel veel dank aan:'}</h2>
    <ul>
      <li><span class="person-icon" aria-hidden="true"></span>Ward Cuiper - {isEnglish ? 'Strategy' : 'Strategie'}</li>
      <li><span class="person-icon" aria-hidden="true"></span>Stefan Leendertse - {isEnglish ? 'Concept development / Design & Copy' : 'Conceptontwikkeling / Design & Copy'}</li>
      <li><span class="person-icon" aria-hidden="true"></span>JP Nieuwerkerk - Copy</li>
      <li>
        <span class="person-icon" aria-hidden="true"></span>
        <a href="https://jpwebcreation.nl">Joris Paardekooper - Webdevelopment</a>
      </li>
    </ul>
  </section>
</footer>
