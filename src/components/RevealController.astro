<script>
  /**
   * WP Elementor entrance motion oracle:
   * - Pre-trigger: visibility hidden (elementor-invisible)
   * - On enter: animated + slideInUp|Down|Right, 1.25s ease, delay 0
   * - Pure translate of 100% element size; opacity stays 1 (no fade)
   */
  const mountReveals = () => {
    const elements = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
    if (!elements.length) return;

    const reveal = (element: HTMLElement) => {
      const name = element.dataset.reveal || 'slideInUp';
      element.classList.add('is-visible', 'animated', name);
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      elements.forEach((element) => reveal(element));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          reveal(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.14 },
    );

    elements.forEach((element) => observer.observe(element));
  };

  mountReveals();
  document.addEventListener('astro:page-load', mountReveals);
</script>
